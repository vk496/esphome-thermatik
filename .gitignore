# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# Local APK extraction, decompiler tools and validation environments
/.analysis/
__pycache__/
*.py[cod]

# Supplied Android app bundles used for local protocol analysis
/*.xapk
